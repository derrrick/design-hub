# Public Supabase client. RLS on the hub tables allows SELECT only.
# The app never writes. Do not put a secret or service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://kfchwbwiqjykontpstgz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_a8aSc4A3BEkCUZgzf1KT3g_HglIDi94

# Optional. Absolute links in the RSS feed use this.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used when this is unset.
NEXT_PUBLIC_SITE_URL=

# Optional. Vercel Cron sends this as `Authorization: Bearer …` to /api/cron.
# Without it the route returns 401 and the site still refreshes on the hourly ISR window.
CRON_SECRET=

# The 3:00am Pacific note does not use a key in this file.
# GitHub Actions provides GITHUB_TOKEN. Optional override: THOUGHT_MODEL.
